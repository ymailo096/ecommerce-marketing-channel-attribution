# Copy to .env and fill in real values. .env is gitignored.
# .env is only for local dev; GitHub Actions uses repo secrets, not this file.

# GCP / BigQuery
GCP_PROJECT_ID=ecommerce-channel-attribution
BQ_LOCATION=EU
BQ_RAW_DATASET=olist_raw
BQ_STAGING_DATASET=olist_staging
BQ_MARTS_DATASET=olist_marts

# Only needed if using auth path B (service-account key file).
# Path A (gcloud ADC) leaves this unset — the library finds ADC on its own.
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/gcp/ecommerce-attribution-sa.json
